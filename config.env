# REDMI K90 (annibale) 构建常量 —— 一般不用改
DEVICE=annibale
MODEL=2510DRK44C
SOC=SM8750
KMI=6.6-android15-8
KERNEL_FAMILY=android15-6.6
PAGE_SIZE=4k

# AOSP kernel/common 的 tag；务必与设备 `adb shell uname -r` 的 6.6.x 对齐
DEFAULT_KERNEL_TAG=android15-6.6.118_r00

# AOSP kernel/manifest 分支（ hermetic 工具链由它决定）
DEFAULT_MANIFEST_BRANCH=common-android15-6.6

# FinaSU 官方源码（Built-In 集成，保留 .git 才能显示完整版本号）
FINASU_REPO=https://github.com/LyraVoid/FinaSU.git
DEFAULT_FINASU_REF=master
